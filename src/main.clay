// knit -- reports from Markdown with Clay code chunks, written as PDF or HTML
//
// Usage:
//   import("knit")
//
//   Knit render("report.md")                  // writes report.pdf
//   Knit render("report.md", #{format: "html"})   // writes report.html
//   Knit render("report.md", #{output: "out/report.pdf", keep: true})
//
// A report is Markdown with ```clay code chunks, as R Markdown has R chunks.
// The chunks run in order as one program, so a variable from one is there in
// the next; the PDF shows each chunk's code, what it printed and the figure it
// drew (with the plot brick, already imported). Chunk options go after
// "clay": ```{clay echo=false} or ```clay echo=false, eval=false, output=false.
//
// How it works: render writes a Clay program beside the report (report.md.clay)
// whose line n is the report's line n -- the chunks' code where it is, the text
// as blank lines, and on each fence line a call into Knit -- and runs it with
// the clay command in the current folder (so it finds the same bricks; Knit
// dir is the report's folder). So an error in a chunk is reported at its line
// in report.md. The program lays out the PDF as it goes (KnitDoc):
// text up to a chunk, the chunk's code, then the output Console capture
// collected and the figure. For HTML (KnitHtml, html.clay) the same items
// become one self-contained page, its figures interactive SVG. $math$ in the
// text is laid out by clay-plot's PlotMath, for both.
//
// Every brick shares one set of top-level names with the program that imports
// it: this one defines Knit, KnitDoc and KnitMarkdown.

import("plot")
import("pdf")
import("markdown.clay")
import("html.clay")

Knit = Object clone {
    _doc = nil

    // Run a report's chunks and write it as PDF or HTML. opts: format
    // ("pdf" or "html"; default: the output's extension, else the front
    // matter's format, else "pdf"), output (the file's path; default the
    // report's, ending in .pdf or .html), keep (keep the generated program),
    // clay (the clay command to run it with). Returns the output's path.
    render(path, opts = nil) {
        o = opts ?? #{}
        (File exists(path)) ifFalse { raise("knit: no such file " + path) }
        md = File read(path)
        format = Knit _format(o get("format"), o get("output"), md)
        out = o get("output") ?? (Knit _stem(path) + "." + format)
        // the program sits beside the report (so bricks/ there is found too)
        // and runs in this folder, as this program does
        gen = path + ".clay"
        File write(gen, Knit program(md, path, out))
        clay = o get("clay") ?? Knit _clay
        r = Process run([clay, gen])
        (o get("keep") == true) ifFalse { File delete(gen) }
        name = Knit _base(path)
        (r ok) ifFalse {
            msg = ((r stderr) + (r stdout)) trim
            raise("knit: " + path + " failed:\n" + (msg replace(name + ".clay", name)))
        }
        // warnings (unknown references...), and what the chunks wrote to stderr
        warn = (r stderr) trim
        (warn != "") ifTrue { Console error((warn replace(name + ".clay", name)) + "\n") }
        out
    }

    // The program for a report at path: line n is the report's line n
    program(md, path, out) {
        lines = (md replace("\r\n", "\n")) split("\n")
        prog = lines map { |l| "" }
        blocks = KnitMarkdown blocks(lines)
        blocks each { |b|
            (b get("kind") == "chunk") ifTrue {
                k = b get("index")
                open = b get("open")
                prog setAt(open, "Knit _chunk(" + k toString + ")")
                run = (b get("options") get("eval")) != false
                run ifTrue {
                    i = open + 1
                    (b get("code")) each { |c| prog setAt(i, c); i = i + 1 }
                }
                close = b get("close")
                (close == nil) ifTrue { prog push("Knit _end(" + k toString + ")") } ifFalse {
                    prog setAt(close, "Knit _end(" + k toString + ")")
                }
            }
        }
        // inline code: each `{clay} expr` evaluated on its own line
        k = 0
        (KnitMarkdown inlineSpans(lines)) each { |sp|
            call = "Knit _inline(" + k toString + ", (" + (sp at(3)) + "))"
            l = prog at(sp at(0))
            prog setAt(sp at(0), (l == "") ifTrue { call } ifFalse { l + "; " + call })
            k = k + 1
        }
        start = "import(\"knit\"); Knit _start(" + (Knit _quote(path)) + ", " + (Knit _quote(out)) + ")"
        first = prog at(0)
        prog setAt(0, (first == "") ifTrue { start } ifFalse { start + "; " + first })
        prog push("Knit _finish")
        (prog join("\n")) + "\n"
    }

    // ---- called by the generated program ----------------------------------------

    // The report's folder, for chunks to find files beside it:
    //   data = File read(Knit dir + "/data.csv")
    dir() { (_doc == nil) ifTrue { "." } ifFalse { _doc _dir } }

    _start(path, out) {
        self _doc = KnitDoc new(path, out)
        Plot close
    }

    // Markdown for a table, to print in a results=asis chunk. rows: Arrays,
    // or Dicts (the first one's keys are the columns). opts: header (the
    // column names), align ("l", "c", "r" or "left", "center", "right" a
    // column; columns of numbers go right, others left), digits (decimal
    // places, for columns with numbers that are not whole), caption, label
    // (for @label references)
    table(rows, opts = nil) {
        o = opts ?? #{}
        dicts = (rows size > 0) && ((rows first type) == "Dict")
        keys = dicts ifTrue { rows first keys } ifFalse { nil }
        header = o get("header") ?? keys
        cells = rows map { |r| dicts ifTrue { keys map { |k| r get(k) } } ifFalse { r } }
        ncol = (header != nil) ifTrue { header size } ifFalse { 0 }
        cells each { |r| ncol = Math max(ncol, r size) }
        cols = (0..(ncol - 1)) map { |j| cells map { |r| (j < r size) ifTrue { r at(j) } ifFalse { nil } } }
        digits = o get("digits")
        align = o get("align") ?? []
        text = []
        aligns = []
        ncol times { |j|
            col = cols at(j)
            nums = col filter { |v| v != nil }
            numeric = (nums size > 0) && ((nums filter { |v| (v type) != "Number" }) size == 0)
            whole = numeric && ((nums filter { |v| v != Math round(v) }) size == 0)
            text push(col map { |v|
                (v == nil) ifTrue { "" } ifFalse {
                    ((digits != nil) && numeric && (whole == false)) ifTrue { Knit _fixed(v, digits) } ifFalse { Knit _cell(v) }
                }
            })
            a = (j < align size) ifTrue { (align at(j)) toString lower } ifFalse { numeric ifTrue { "r" } ifFalse { "l" } }
            aligns push((a startsWith("r")) ifTrue { "--:" } ifFalse { (a startsWith("c")) ifTrue { ":-:" } ifFalse { ":--" } })
        }
        head = (0..(ncol - 1)) map { |j| ((header != nil) && (j < header size)) ifTrue { Knit _cell(header at(j)) } ifFalse { "" } }
        lines = []
        cap = o get("caption")
        label = o get("label")
        ((cap != nil) || (label != nil)) ifTrue {
            capText = (cap != nil) ifTrue { Knit _cell(cap) } ifFalse { "" }
            (label != nil) ifTrue { capText = (capText + " {#" + label + "}") trim }
            lines push("Table: " + capText)
            lines push("")
        }
        lines push("| " + head join(" | ") + " |")
        lines push("|" + aligns join("|") + "|")
        cells size times { |i| lines push("| " + ((text map { |c| c at(i) }) join(" | ")) + " |") }
        lines join("\n") + "\n"
    }

    _chunk(k) {
        _doc chunk(k)
        Console beginCapture
    }

    // An inline expression's value, as text, for span k
    _inline(k, v) { _doc inline(k, v) }

    // x with digits decimal places, as text: for inline code, `{clay} Knit fixed(mean, 2)`
    fixed(x, digits) { Knit _fixed(x, digits) }

    _end(k) {
        text = Console endCapture
        _doc chunkEnd(k, text)
    }

    _finish() { _doc finish }

    // ---- helpers ----------------------------------------------------------------

    // "pdf" or "html": the format asked for, else the output's extension,
    // else the front matter's format (or output: html_document, as R
    // Markdown's), else "pdf"
    _format(format, output, md) {
        pick = { |v|
            t = (v == nil) ifTrue { "" } ifFalse { (v toString) lower trim }
            (t startsWith("html")) ifTrue { "html" } ifFalse { (t startsWith("pdf")) ifTrue { "pdf" } ifFalse { nil } }
        }
        (format != nil) ifTrue {
            f = pick value(format)
            (f == nil) ifTrue { raise("knit: format is \"pdf\" or \"html\", not '" + format toString + "'") }
            return f
        }
        (output != nil) ifTrue {
            l = (output toString) lower
            ((l endsWith(".html")) || (l endsWith(".htm"))) ifTrue { return "html" }
            (l endsWith(".pdf")) ifTrue { return "pdf" }
        }
        lines = (md replace("\r\n", "\n")) split("\n")
        bs = KnitMarkdown blocks(lines)
        ((bs size > 0) && (((bs first) get("kind")) == "front")) ifTrue {
            fields = (bs first) get("fields")
            f = pick value((fields get("format")) ?? (fields get("output")))
            (f != nil) ifTrue { return f }
        }
        "pdf"
    }

    // The clay command: this one, when running in it
    _clay() {
        exe = System executable ?? ""
        base = (Knit _base(exe)) lower
        ((base == "clay") || (base == "clay.exe")) ifTrue { exe } ifFalse { "clay" }
    }

    _quote(s) { "\"" + ((s replace("\\", "\\\\")) replace("\"", "\\\"")) + "\"" }

    // A value as a table cell: one line, its |s escaped
    _cell(v) {
        ((v toString) replace("\n", " ") replace("\r", "")) replace("|", "\\|")
    }

    // A number written as text ("4", "4.5", ".5"), else nil
    _num(t) {
        s = (t toString) trim
        ok = s length > 0
        dots = 0
        digits = 0
        (s bytes) each { |c|
            (c == 46) ifTrue { dots = dots + 1 } ifFalse {
                ((c >= 48) && (c <= 57)) ifTrue { digits = digits + 1 } ifFalse { ok = false }
            }
        }
        (ok && (dots <= 1) && (digits > 0)) ifTrue { s toFloat } ifFalse { nil }
    }

    // An option's value as a number above 0 (nil if not given); raises if it
    // is something else
    _positive(v, name) {
        (v == nil) ifTrue { return nil }
        n = Knit _num(v)
        ((n == nil) || (n <= 0)) ifTrue { raise("knit: " + name + " is a number above 0, not '" + v toString + "'") }
        n
    }

    // x with digits decimal places
    _fixed(x, digits) {
        (digits <= 0) ifTrue { return (Math round(x)) toString }
        n = Math round(x * Math round(Math pow(10, digits)))
        neg = n < 0
        s = (neg ifTrue { 0 - n } ifFalse { n }) toString
        { s length <= digits } whileTrue { s = "0" + s }
        s = (s slice(0, s length - digits)) + "." + (s slice(s length - digits, s length))
        neg ifTrue { "-" + s } ifFalse { s }
    }

    _slash(path) {
        a = path lastIndexOf("/")
        b = path lastIndexOf("\\")
        (a > b) ifTrue { a } ifFalse { b }
    }

    _dir(path) {
        i = Knit _slash(path)
        (i < 0) ifTrue { "." } ifFalse { (i == 0) ifTrue { "/" } ifFalse { path slice(0, i) } }
    }

    _base(path) {
        i = Knit _slash(path)
        (i < 0) ifTrue { path } ifFalse { path slice(i + 1, path length) }
    }

    _stem(path) {
        dot = path lastIndexOf(".")
        (dot > Knit _slash(path)) ifTrue { path slice(0, dot) } ifFalse { path }
    }

    _isAbsolute(path) {
        (path startsWith("/")) || (path startsWith("\\")) || ((path length > 1) && (path byteAt(1) == 58))
    }
}

// KnitDoc -- lays out a report as its program runs: text, code, output, figures
KnitDoc = Object clone {
    init(path, out) {
        self _out = out
        self _path = path
        lo = out lower
        self _html = (lo endsWith(".html")) || (lo endsWith(".htm"))
        self _dir = Knit _dir(path)
        lines = ((File read(path)) replace("\r\n", "\n")) split("\n")
        // inline code becomes placeholders, for the values once they are known
        self _blocks = KnitMarkdown blocks(KnitMarkdown withPlaceholders(lines))
        self _values = []
        self _next = 0            // the next block to lay out
        self _pdf = Pdf new("letter")
        self _flow = _pdf flow(72)
        self _size = 11           // body text
        self _codeSize = 9
        self _chunkOpts = #{}
        self _items = []          // what to lay out at the end: blocks, chunks' code, output, figures
        // the front matter's fields are the report's defaults for chunk options (fig-width...)
        first = (_blocks size > 0) ifTrue { _blocks first } ifFalse { nil }
        self _defaults = ((first != nil) && ((first get("kind")) == "front")) ifTrue { first get("fields") } ifFalse { #{} }
        self _savedSize = nil
        self _figureCaption = []
        self _captionBox = nil
        self
    }

    // The document is laid out at the end, once every chunk has run, so
    // figures and tables are numbered before any text that refers to them.
    // Until then chunk() and chunkEnd() collect what to lay out.

    // Inline span k's value
    inline(k, v) {
        { _values size <= k } whileTrue { _values push(nil) }
        _values setAt(k, (v == nil) ifTrue { "nil" } ifFalse { v toString })
    }

    // Before chunk k runs: the text up to it, and its code
    chunk(k) {
        b = self _upTo(k)
        self _chunkOpts = b get("options")
        ((_chunkOpts get("echo")) != false) ifTrue { _items push(#{kind: "code", code: b get("code"), lang: "clay"}) }
        self _figureSize
    }

    // After chunk k: what it printed, and its figure
    chunkEnd(k, text) {
        show = (_chunkOpts get("output")) != false
        results = ((_chunkOpts get("results")) ?? "") toString lower
        ((text != "") && show && (results != "hide")) ifTrue {
            (results == "asis") ifTrue {
                // printed Markdown, laid out as the report's text is
                (KnitMarkdown blocks((text replace("\r\n", "\n")) split("\n"))) each { |b|
                    ((b get("kind")) == "front") ifFalse { _items push(b) }
                }
            } ifFalse { _items push(#{kind: "output", text: text}) }
        }
        fig = Plot current
        ((fig != nil) && (fig axesList size > 0) && show) ifTrue {
            cap = (_chunkOpts get("caption")) ?? (_chunkOpts get("fig.cap"))
            (cap == true) ifTrue { cap = nil }
            _items push(#{kind: "figure", fig: fig, caption: cap, label: _chunkOpts get("label"),
                width: self _opt("out.width"), align: self _opt("fig.align"), interactive: self _opt("interactive")})
        }
        Plot close
        (_savedSize != nil) ifTrue {
            Plot rc set("figure.figsize", _savedSize)
            self _savedSize = nil
        }
        _items push(#{kind: "space", height: 6})
    }

    // A chunk option, or else the report's default (front matter), as
    // knitr spells it (fig.width) or as Quarto does (fig-width)
    _opt(name) {
        dash = name replace(".", "-")
        v = (_chunkOpts get(name)) ?? (_chunkOpts get(dash))
        (v == nil) ifTrue { v = (_defaults get(name)) ?? (_defaults get(dash)) }
        v
    }

    // fig.width, fig.height (inches) and fig.asp (height / width): the size
    // figures made in this chunk get, unless its code gives one (figsize).
    // One of width and height alone keeps the default's shape.
    _figureSize() {
        w = Knit _positive(self _opt("fig.width"), "fig.width")
        h = Knit _positive(self _opt("fig.height"), "fig.height")
        asp = Knit _positive(self _opt("fig.asp"), "fig.asp")
        ((w == nil) && (h == nil) && (asp == nil)) ifTrue { return nil }
        base = Plot rc get("figure.figsize")
        self _savedSize = base
        fw = w ?? (base at(0))
        fh = h
        (fh == nil) ifTrue {
            fh = (asp != nil) ifTrue { fw * asp } ifFalse {
                (w != nil) ifTrue { fw * ((base at(1)) / ((base at(0)) * 1.0)) } ifFalse { base at(1) }
            }
        }
        Plot rc set("figure.figsize", [fw, fh])
    }

    // The width a figure (or image) is shown at: its own (natural, points),
    // or width (out.width: "50%" of the text, "3in", "8cm", "60mm", "200pt",
    // or pixels, "300px" or "300"); never wider than the text
    _shownWidth(width, natural) {
        (width == nil) ifTrue { return Math min(_flow width, natural) }
        t = (width toString) trim
        units = [["%", _flow width / 100.0], ["in", 72], ["cm", 72 / 2.54], ["mm", 72 / 25.4], ["pt", 1], ["px", 0.75], ["", 0.75]]
        w = nil
        units each { |u|
            ((w == nil) && (t endsWith(u at(0)))) ifTrue {
                n = Knit _num((t slice(0, t length - ((u at(0)) length))) trim)
                (n != nil) ifTrue { w = n * (u at(1)) }
            }
        }
        ((w == nil) || (w <= 0)) ifTrue { raise("knit: a width is a size like 50%, 3in, 8cm or 200pt, not '" + t + "'") }
        Math min(_flow width, w)
    }

    // The report's default for an option (front matter), either spelling
    _defaultOpt(name) { (_defaults get(name)) ?? (_defaults get(name replace(".", "-"))) }

    // Where a figure w wide starts: align "left", "right", or centered
    _alignX(w, align) {
        a = ((align ?? "center") toString) lower
        (a == "left") ifTrue { return _flow x }
        (a == "right") ifTrue { return _flow x + _flow width - w }
        _flow x + (_flow width - w) / 2
    }

    // The rest of the text; numbering; layout; page numbers; save
    finish() {
        self _collectTo(_blocks size)
        self _number
        KnitMarkdown useValues(_values)
        KnitMarkdown forPdf(_html not)
        _html ifTrue {
            File write(_out, KnitHtml page(self))
            self _warnMissing
            return _out
        }
        _items each { |b| self _block(b) }
        self _warnMissing
        n = _pdf pageCount
        i = 0
        _pdf pages each { |page|
            i = i + 1
            page font("Helvetica", 9) fillColor("#808080") textAlign("center")
            page text(page width / 2, page height - 36, i toString + " / " + n toString)
            page textAlign("left")
        }
        _pdf save(_out)
    }

    // A labelled figure, image or table: a place its @label references jump to
    _anchorLabel(b) {
        label = b get("label")
        (label != nil) ifTrue { _flow anchor(label) }
    }

    // The @fig-x and @tbl-x references to labels nobody has
    _warnMissing() {
        (KnitMarkdown missing) each { |label|
            Console error("knit: " + _path + ": no figure or table is labelled " + label + " (@" + label + ")\n")
        }
    }

    // ---- laying out blocks ------------------------------------------------------

    // Collect the blocks before chunk k; returns chunk k's block
    _upTo(k) {
        i = _next
        { (i < _blocks size) && (((_blocks at(i)) get("kind") != "chunk") || ((_blocks at(i)) get("index") != k)) } whileTrue { i = i + 1 }
        self _collectTo(i)
        self _next = i + 1
        _blocks at(i)
    }

    _collectTo(end) {
        { _next < end } whileTrue {
            _items push(_blocks at(_next))
            self _next = _next + 1
        }
    }

    // Number the tables, and the figures and images, with a caption or a
    // label ("Table 1", "Figure 1"... in "number"), and give the labels'
    // numbers to KnitMarkdown, for @label references
    _number() {
        refs = #{}
        tables = 0
        figures = 0
        _items each { |b|
            kind = b get("kind")
            label = b get("label")
            caption = b get("caption")
            (kind == "image") ifTrue { caption = ((b get("alt")) == "") ifTrue { nil } ifFalse { b get("alt") } }
            name = nil
            ((kind == "table") && ((caption != nil) || (label != nil))) ifTrue {
                tables = tables + 1
                name = "Table " + tables toString
            }
            (((kind == "figure") || (kind == "image")) && ((caption != nil) || (label != nil))) ifTrue {
                figures = figures + 1
                name = "Figure " + figures toString
            }
            (name != nil) ifTrue {
                b set("number", name)
                (label != nil) ifTrue {
                    (refs has(label)) ifTrue {
                        Console error("knit: " + _path + ": label " + label + " is used twice; @" + label + " is " + refs get(label) + "\n")
                    } ifFalse { refs set(label, name) }
                }
            }
        }
        KnitMarkdown useRefs(refs)
    }

    _block(b) {
        kind = b get("kind")
        (kind == "front") ifTrue { return self _front(b get("fields")) }
        (kind == "heading") ifTrue { return self _heading(b get("level"), b get("text")) }
        (kind == "para") ifTrue { return self _para(KnitMarkdown runs(b get("text")), 0) }
        (kind == "list") ifTrue { return self _list(b get("items")) }
        (kind == "quote") ifTrue { return self _para(KnitMarkdown runs(b get("text"), false, "#555555"), 18) }
        ((kind == "code") || (kind == "chunk")) ifTrue { return self _code(b get("code"), "#f3f3f3") }
        (kind == "table") ifTrue { return self _table(b) }
        (kind == "image") ifTrue { return self _image(b) }
        (kind == "figure") ifTrue { return self _figure(b) }
        (kind == "output") ifTrue { return self _output(b get("text")) }
        (kind == "space") ifTrue { return _flow space(b get("height")) }
        (kind == "math") ifTrue {
            size = _size * 1.15
            rs = KnitMarkdown runs("$$" + (b get("text")) + "$$")
            // limits above and below a sum need room: taller lines
            stacked = (rs find { |r| (r size > 3) && ((r at(3)) != nil) && ((r at(3)) get("stack") != nil) }) != nil
            _flow font("Helvetica", size) lineHeight(size * (stacked ifTrue { 2.2 } ifFalse { 1.6 }))
            _flow space(_size * 0.2)
            _flow richParagraph(rs, "center")
            return _flow space(_size * 0.6)
        }
        (kind == "rule") ifTrue {
            page = _flow ensure(12)
            y = _flow y + 6
            page strokeColor("#c0c0c0") lineWidth(0.75) line(_flow x, y, _flow x + _flow width, y)
            _flow space(12)
        }
        nil
    }

    _front(fields) {
        title = fields get("title")
        (title != nil) ifTrue {
            _pdf title(KnitMarkdown plain(title))
            _flow font("Helvetica-Bold", 20) lineHeight(26) color(nil)
            _flow richParagraph(KnitMarkdown runs(title, true), "center")
            _flow space(4)
        }
        ["author", "date"] each { |key|
            v = fields get(key)
            (v != nil) ifTrue {
                (key == "author") ifTrue { _pdf author(KnitMarkdown plain(v)) }
                _flow font("Helvetica", 12) lineHeight(16)
                _flow richParagraph(KnitMarkdown runs(v), "center")
            }
        }
        _flow space(16)
    }

    _heading(level, text) {
        size = [20, 16, 13, 12, 11, 11] at(level - 1)
        _flow space([14, 12, 10, 8, 8, 8] at(level - 1))
        // keep a heading with the first lines after it
        _flow ensure(size * 1.25 + _size * 3)
        // a bookmark in the PDF's outline, and a place [text](#id) links jump to
        plain = KnitMarkdown plain(text)
        _flow anchor(KnitHtml slug(plain))
        _flow bookmark(plain, level)
        _flow font("Helvetica-Bold", size) lineHeight(size * 1.25) color(nil)
        _flow richParagraph(KnitMarkdown runs(text, true))
        _flow space(4)
    }

    _para(runs, indent) {
        _flow font("Helvetica", _size) lineHeight(_size * 1.4)
        _flow richParagraph(runs, "left", indent)
        _flow space(_size * 0.6)
    }

    _list(items) {
        _flow font("Helvetica", _size) lineHeight(_size * 1.4)
        lh = _size * 1.4
        ascent = Pdf ascent("Helvetica", _size)
        items each { |it|
            depth = it at(3)
            x = _flow x + (depth * 18)
            page = _flow ensure(lh)
            marker = (it at(0)) ifTrue { it at(1) } ifFalse { "\xe2\x80\xa2" }
            page font("Helvetica", _size) fillColor("#000000")
            page text(x + 4, _flow y + ascent, marker)
            _flow richParagraph(KnitMarkdown runs(it at(2)), "left", (depth * 18) + 18)
            _flow space(_size * 0.2)
        }
        _flow space(_size * 0.4)
    }

    // Lines of code (or output) in Courier on a band of background (nil: none)
    _code(lines, background) {
        size = _codeSize
        lh = size * 1.35
        pad = 6
        w = _flow width
        ascent = Pdf ascent("Courier", size)
        rows = []
        lines each { |l|
            line = (l replace("\t", "    ")) replace("\r", "")
            ((line length == 0) || ((Pdf textWidth(line, "Courier", size)) <= (w - 2 * pad))) ifTrue { rows push(line) } ifFalse {
                rest = line
                { (rest length > 0) && ((Pdf textWidth(rest, "Courier", size)) > (w - 2 * pad)) } whileTrue {
                    cut = Pdf _fit(rest, w - 2 * pad, "Courier", size)
                    rows push(rest slice(0, cut))
                    rest = rest slice(cut, rest length)
                }
                rows push(rest)
            }
        }
        // drop blank lines at the ends
        { (rows size > 0) && (((rows at(rows size - 1)) trim) == "") } whileTrue { rows = rows slice(0, rows size - 1) }
        (rows size == 0) ifTrue { return nil }
        _flow ensure(lh + pad)
        _flow space(2)
        i = 0
        rows each { |row|
            first = i == 0
            last = i == (rows size - 1)
            top = first ifTrue { pad } ifFalse { 0 }
            bottom = last ifTrue { pad } ifFalse { 0 }
            page = _flow ensure(top + lh + bottom)
            (background != nil) ifTrue {
                page fillColor(background) fillRect(_flow x, _flow y, w, top + lh + bottom)
            }
            page font("Courier", size) fillColor("#1a1a1a") textAlign("left")
            page text(_flow x + pad, _flow y + top + ascent + (lh - size) / 2, row)
            _flow space(top + lh + bottom)
            i = i + 1
        }
        _flow space(8)
    }

    // A table, centered: columns as wide as their text, or, if that is too
    // wide, narrowed toward their longest words, wrapping; rules above, under
    // the header and at the end; the header again on each page it runs onto
    _table(b) {
        size = _size - 1
        lh = size * 1.3
        pad = 6
        aligns = b get("align")
        ncol = aligns size
        header = (b get("header")) map { |c| KnitMarkdown runs(c, true) }
        rows = (b get("rows")) map { |r| r map { |c| KnitMarkdown runs(c) } }
        all = [header]
        rows each { |r| all push(r) }
        // each column's width on one line, and its longest word's
        nat = []
        mins = []
        ncol times { |j| nat push(0); mins push(0) }
        all each { |r|
            ncol times { |j|
                one = Pdf wrapRuns(r at(j), 1000000, size)
                (one size > 0) ifTrue { nat setAt(j, Math max(nat at(j), (one at(0)) at(1) + 2 * pad)) }
                (Pdf wrapRuns(r at(j), 0, size)) each { |l| mins setAt(j, Math max(mins at(j), (l at(1)) + 2 * pad)) }
            }
        }
        avail = _flow width
        total = 0
        nat each { |w| total = total + w }
        widths = nat
        (total > avail) ifTrue {
            least = 0
            mins each { |w| least = least + w }
            widths = (least >= avail) ifTrue { mins map { |w| w * avail / (least * 1.0) } } ifFalse {
                k = (avail - least) / ((total - least) * 1.0)
                (0..(ncol - 1)) map { |j| (mins at(j)) + ((nat at(j)) - (mins at(j))) * k }
            }
            total = avail
        }
        x0 = _flow x + (avail - total) / 2
        x1 = x0 + total
        cut = (0..(ncol - 1)) map { |j| (widths at(j)) < (mins at(j)) }
        // a header of empty cells is left out
        head = self _tableCells(header, widths, pad, size, lh)
        ((((b get("header")) filter { |c| c != "" }) size) == 0) ifTrue { head = nil }
        // "Table n: caption" above it, wrapped to the text width
        caption = []
        (b get("number") != nil) ifTrue { caption = self _caption(b get("number"), b get("caption")) }
        capH = (caption size > 0) ifTrue { caption size * lh + 4 } ifFalse { 0 }
        _flow space(4)
        // keep the caption and header with the first row
        page = _flow ensure(capH + ((head != nil) ifTrue { head at(1) } ifFalse { 0 }) +
            ((rows size > 0) ifTrue { (self _tableCells(rows first, widths, pad, size, lh)) at(1) } ifFalse { 0 }))
        self _anchorLabel(b)
        self _drawCaption(caption)
        (capH > 0) ifTrue { _flow space(4) }
        self _tableHead(head, widths, aligns, cut, x0, x1, pad, size, lh)
        rows each { |r|
            cells = self _tableCells(r, widths, pad, size, lh)
            before = _flow page
            y = _flow y
            page = _flow ensure(cells at(1))
            (page != before) ifTrue {
                before strokeColor("#000000") lineWidth(0.8) line(x0, y, x1, y)
                self _tableHead(head, widths, aligns, cut, x0, x1, pad, size, lh)
            }
            self _tableRow(page, cells at(0), widths, aligns, cut, x0, _flow y, pad, size, lh)
            _flow space(cells at(1))
        }
        _flow page strokeColor("#000000") lineWidth(0.8) line(x0, _flow y, x1, _flow y)
        _flow space(_size)
    }

    // A row's cells wrapped to the columns, and the row's height: [cells, height]
    _tableCells(row, widths, pad, size, lh) {
        lines = 1
        cells = (0..(row size - 1)) map { |j|
            c = Pdf wrapRuns(row at(j), (widths at(j)) - 2 * pad + 0.01, size)
            lines = Math max(lines, c size)
            c
        }
        [cells, lines * lh + 6]
    }

    _tableHead(head, widths, aligns, cut, x0, x1, pad, size, lh) {
        page = _flow page
        page strokeColor("#000000") lineWidth(0.8) line(x0, _flow y, x1, _flow y)
        (head == nil) ifTrue { return nil }
        self _tableRow(page, head at(0), widths, aligns, cut, x0, _flow y, pad, size, lh)
        _flow space(head at(1))
        page strokeColor("#000000") lineWidth(0.4) line(x0, _flow y, x1, _flow y)
    }

    // Draw a row's wrapped cells with its top at y; a cell narrower than its
    // longest word (cut) is clipped to its column
    _tableRow(page, cells, widths, aligns, cut, x0, y, pad, size, lh) {
        ascent = Pdf ascent("Helvetica", size)
        x = x0
        j = 0
        cells each { |lines|
            w = widths at(j)
            a = aligns at(j)
            (cut at(j)) ifTrue { page save clipRect(x, y, w, (lines size) * lh + 6) }
            ly = y + 3 + ascent + (lh - size) / 2
            lines each { |l|
                dx = pad
                (a == "center") ifTrue { dx = (w - (l at(1))) / 2 }
                (a == "right") ifTrue { dx = w - pad - (l at(1)) }
                page runs(x + dx, ly, l at(0), size)
                ly = ly + lh
            }
            (cut at(j)) ifTrue { page restore }
            x = x + w
            j = j + 1
        }
    }

    // A chunk's printed output: like code, with a rule down its left side
    _output(text) {
        lines = text split("\n")
        ((lines size > 0) && ((lines at(lines size - 1)) == "")) ifTrue { lines = lines slice(0, lines size - 1) }
        startPage = _flow page
        startY = _flow y + 2
        self _code(lines, nil)
        (_flow page == startPage) ifTrue {
            startPage strokeColor("#b0b0b0") lineWidth(1.5) line(_flow x + 1, startY, _flow x + 1, _flow y - 8)
        }
    }

    // A chunk's figure at its own size, or narrowed to the text width, with
    // its caption under it
    _figure(b) {
        fig = b get("fig")
        w = self _shownWidth(b get("width"), fig widthIn * 72)
        h = w * (fig heightIn / (fig widthIn * 1.0))
        x = self _alignX(w, b get("align"))
        page = self _figureSpace(h, b, x, w, b get("align"))
        self _anchorLabel(b)
        fig drawPdf(page, x, _flow y, w)
        self _figureEnd(h)
    }

    // Room for a figure h tall and its caption, kept on one page. The
    // caption goes under the figure (x, w wide): centered on the text, or
    // for a figure aligned left or right, in a box at least 3 inches wide
    // aligned with it
    _figureSpace(h, b, x, w, align) {
        a = ((align ?? "center") toString) lower
        boxW = _flow width
        boxX = _flow x
        ((a == "left") || (a == "right")) ifTrue {
            boxW = Math min(_flow width, Math max(w, 216))
            boxX = (a == "left") ifTrue { x } ifFalse { x + w - boxW }
        }
        self _captionBox = [boxX, boxW]
        lines = []
        (b get("number") != nil) ifTrue {
            text = (b get("kind") == "image") ifTrue { b get("alt") } ifFalse { b get("caption") }
            lines = self _caption(b get("number"), text, boxW)
        }
        self _figureCaption = lines
        _flow ensure(h + ((lines size > 0) ifTrue { 4 + lines size * (_size - 1) * 1.3 } ifFalse { 0 }))
    }

    _figureEnd(h) {
        _flow advance(h)
        (_figureCaption size > 0) ifTrue {
            _flow space(4)
            self _drawCaption(_figureCaption, _captionBox at(0), _captionBox at(1))
        }
        _flow space(10)
    }

    // A caption's lines: "Figure n: " in bold, then the text (Markdown;
    // nil or "": just "Figure n"), wrapped to width (default: the text's)
    _caption(name, text, width = nil) {
        w = width ?? _flow width
        ((text == nil) || (text toString == "")) ifTrue { return Pdf wrapRuns([[name, "Helvetica-Bold"]], w, _size - 1) }
        Pdf wrapRuns([[name + ": ", "Helvetica-Bold"]] + KnitMarkdown runs(text toString), w, _size - 1)
    }

    // Caption lines, centered in a box (x, width; default: the text), from
    // the flow's place down
    _drawCaption(lines, x = nil, width = nil) {
        size = _size - 1
        lh = size * 1.3
        ascent = Pdf ascent("Helvetica", size)
        bx = x ?? _flow x
        bw = width ?? _flow width
        lines each { |l|
            _flow page runs(bx + (bw - (l at(1))) / 2, _flow y + ascent, l at(0), size)
            _flow space(lh)
        }
    }

    // An image file (PNG or JPEG) at a point a pixel, narrowed to the text width
    _image(b) {
        path = b get("path")
        img = nil
        full = ((Knit _isAbsolute(path)) || (_dir == ".")) ifTrue { path } ifFalse { _dir + "/" + path }
        try { img = _pdf loadImage(full) } catch { |e|
            return self _para([["[image " + path + ": " + e message + "]", "Helvetica-Oblique", "#aa0000"]], 0)
        }
        w = self _shownWidth((b get("width")) ?? (self _defaultOpt("out.width")), img width * 0.75)
        h = w * (img height / (img width * 1.0))
        align = (b get("align")) ?? (self _defaultOpt("fig.align"))
        x = self _alignX(w, align)
        page = self _figureSpace(h, b, x, w, align)
        self _anchorLabel(b)
        page image(img, x, _flow y, w, h)
        self _figureEnd(h)
    }
}
